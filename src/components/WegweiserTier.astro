    <path d="M8 21 L2.5 22.6 L8.4 24 Z" fill="#2a2420" />
    <circle cx="12" cy="19.6" r="1.1" fill="#1b1612" />
  </g>
  <path d="M20 34 V40 M27 34 V40" stroke="#2a2420" stroke-width="1.4" stroke-linecap="round" />
</svg>

