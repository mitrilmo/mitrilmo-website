---
import '../styles/global.css';
import seasonFn from '../lib/season.js?raw';
import { fontFaceCss } from '../lib/fonts.js';
import { nav } from '../data/nav.js';
import MobileBar from '../components/MobileBar.astro';

const {
  title,
  description = 'mitrilmo: Wandern, Radfahren und Neugier im Bergischen Land.',
  ogImage, // Pfad ab Site-Root inkl. Basispfad (z. B. von getImage); Standard: Kanal-Logo
  ogType = 'website',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const staging = base !== '';
// Canonical immer auf die .html-Adresse (die Variante ohne Endung liefert GitHub Pages ebenfalls aus)
const path = Astro.url.pathname.replace(/\/$/, '') || '';
const canonical = new URL(path.endsWith('.html') || path === base ? path || '/' : path + '.html', Astro.site).href;
const ogImageUrl = new URL(ogImage ?? `${base}/images/channel-logo.jpg`, Astro.site).href;

// Jahreszeit aus dem Datum, per ?season=herbst testbar. Ohne JavaScript bleibt der Standard (herbst).
const seasonScript = seasonFn + `
(function () {
  var ok = ['fruehling', 'sommer', 'herbst', 'winter'];
  var q = new URLSearchParams(location.search).get('season');
  document.documentElement.setAttribute('data-season', ok.indexOf(q) >= 0 ? q : seasonFor(new Date()));
})();`;
---
<!doctype html>
<html lang="de" data-season="herbst">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="mitrilmo" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="mitrilmo: Neuigkeiten und Geschichten" href={`${base}/feed.xml`} />
  {staging && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
  <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <style set:html={fontFaceCss(base)}></style>
  <script is:inline set:html={seasonScript}></script>
  <slot name="head" />
  <script is:inline defer src="https://mobrain.tail4c30a8.ts.net/script.js" data-website-id="b0279420-580a-4f86-99df-4ac427936c73" data-domains="mitrilmo.com,www.mitrilmo.com"></script>
</head>
<body class="bg-slate-800 text-stone-200 font-sans antialiased min-h-screen flex flex-col">
  <a href="#inhalt" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-slate-950 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Zum Inhalt springen</a>
  <header class="bg-slate-900/90 border-b border-white/5">
    <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href={`${base}/`} class="font-black text-lg tracking-tight text-white"><span class="text-forest-400">mitril</span>mo</a>
      <nav aria-label="Hauptnavigation" class="hidden md:flex gap-5 text-sm font-medium text-stone-300">
        {nav.filter((n) => n.live && n.header !== false).map((n) => (
          <a href={`${base}/${n.href}`} class="hover:text-accent transition-colors">{n.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="inhalt" tabindex="-1" class="flex-1 focus:outline-none"><slot /></main>

  <footer class="border-t border-white/5 bg-slate-950/50">
    <div class="max-w-5xl mx-auto px-4 pt-8 pb-24 md:pb-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-400">
      <p>© 2026 mitrilmo · Bergisches Land, NRW</p>
      <p>
        <a href={`${base}/#impressum`} class="hover:text-accent transition-colors">Impressum</a><span class="mx-2" aria-hidden="true">·</span><a href={`${base}/#datenschutz`} class="hover:text-accent transition-colors">Datenschutz</a>
      </p>
    </div>
  </footer>

  <MobileBar />
</body>
</html>
