---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContentImage from '../components/ContentImage.astro';
import { teaser, published } from '../lib/news.js';
import { dateDe } from '../lib/date.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = published(await getCollection('news'));
---
<Base title="Neuigkeiten, mitrilmo" description="Kurze Beiträge von unterwegs: Ausflüge, Veranstaltungen und was sonst gerade ansteht.">
  <PageHero width="max-w-3xl">
    <h1 class="text-3xl font-black text-stone-50">Neuigkeiten</h1>
    <p class="mt-2 text-stone-200">Kurze Beiträge von unterwegs. Die längeren Berichte stehen unter Geschichten.</p>
  </PageHero>

  <section class="max-w-3xl mx-auto px-4 py-10">
    {posts.length === 0 && <p class="text-stone-400">Noch keine Beiträge.</p>}
    <ul class="space-y-6">
      {posts.map((p, i) => (
        <li>
          <article class="bg-slate-700 rounded-2xl overflow-hidden border border-white/5 sm:flex">
            <a href={`${base}/neuigkeiten/${p.id}.html`} class="sm:w-56 sm:shrink-0 block" aria-hidden="true" tabindex="-1">
              <ContentImage avifOnly image={p.data.cover} alt={p.data.coverAlt} sizes="(min-width: 640px) 224px, 100vw" widths={[480, 800]} priority={i === 0} class="w-full h-48 sm:h-full object-cover" />
            </a>
            <div class="p-5">
              <p class="text-xs text-stone-400"><time datetime={p.data.date.toISOString().slice(0, 10)}>{dateDe(p.data.date)}</time></p>
              <h2 class="mt-1 text-lg font-bold text-stone-50"><a href={`${base}/neuigkeiten/${p.id}.html`} class="hover:text-accent transition-colors">{p.data.title}</a></h2>
              <p class="mt-2 text-sm text-stone-300">{teaser(p)}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>
</Base>
