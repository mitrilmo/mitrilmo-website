---
// Das Spiel „Mo’s Hike Quest“ (Entscheidung Björn 09.11.2026: Teil der Website unter /projekte/mos-hike-quest.html).
// Eigenständige Seite ohne Kopfzeile, damit die Spielfläche das Fenster ausnutzt (Handy quer). Kopf, Umami und
// Rechtliches wie auf den anderen Seiten. Das Spiel lädt nichts nach und speichert nichts (Spielskript: src/game/).
import { getImage } from 'astro:assets';
import gameJs from '../../game/mos-hike-quest.js?raw';
import vorschau from '../../assets/images/spiel/mos-hike-quest-vorschau.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const staging = base !== '';
const title = 'Mo’s Hike Quest, mitrilmo';
const description = 'Mo’s Hike Quest: ein kleines Wanderspiel von mitrilmo für den Browser. Es lädt nichts nach und speichert nichts.';
const path = Astro.url.pathname.replace(/\/$/, '') || '';
const canonical = new URL(path.endsWith('.html') ? path : path + '.html', Astro.site).href;
// Vorschaubild für Messenger (WhatsApp, Signal, Telegram …): Szene aus dem Spiel, 1200 × 630
const og = await getImage({ src: vorschau, width: 1200, format: 'jpeg', quality: 70 });
const ogImageUrl = new URL(og.src, Astro.site).href;
const ogImageAlt = 'Mo steht vor seiner Hütte und sagt: Guten Morgen, ich bin Mo. Daneben der Titel Mo’s Hike Quest und das mitrilmo-Logo.';
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#15130f" />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="mitrilmo" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content={String(og.attributes.width)} />
  <meta property="og:image:height" content={String(og.attributes.height)} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  {staging && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
  <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <style is:inline>
    html,body{margin:0;height:100%;background:#15130f;color:#d9d4cc;font-family:system-ui,sans-serif}
    body{display:flex;flex-direction:column;overflow:hidden}
    main{flex:1;min-height:0;display:flex;align-items:center;justify-content:center}
    canvas{display:block;width:min(100vw,calc((100vh - 38px) * 2));width:min(100vw,calc((100dvh - 38px) * 2));height:auto;touch-action:manipulation;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}
    footer{flex:none;min-height:38px;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;column-gap:.4rem;font-size:13px;color:#a89d8f;padding:2px 12px}
    footer a{color:#a89d8f;text-decoration:none;padding:8px 2px}
    footer a:hover,footer a:focus-visible{color:#fff;text-decoration:underline}
    .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    noscript p{margin:0;padding:1rem;text-align:center}
  </style>
  <script is:inline defer src="https://mobrain.tail4c30a8.ts.net/script.js" data-website-id="b0279420-580a-4f86-99df-4ac427936c73" data-domains="mitrilmo.com,www.mitrilmo.com"></script>
</head>
<body>
  <main>
    <h1 class="sr-only">Mo’s Hike Quest</h1>
    <p id="steuerung" class="sr-only">Steuerung: Springen mit Leertaste oder Pfeil hoch, gedrückt halten springt höher. Ducken mit Pfeil runter oder S. Pause mit P oder Escape. Am Handy tippen zum Springen, das untere Drittel gedrückt halten zum Ducken.</p>
    <canvas id="c" width="1360" height="680" role="img" aria-label="Mo’s Hike Quest: Spielfläche" aria-describedby="steuerung"></canvas>
    <noscript><p>Für das Spiel wird JavaScript gebraucht.</p></noscript>
  </main>
  <footer>
    <a href={`${base}/`}>mitrilmo</a><span aria-hidden="true">·</span>
    <a href={`${base}/projekte.html`}>Projekte</a><span aria-hidden="true">·</span>
    <a href={`${base}/#impressum`}>Impressum</a><span aria-hidden="true">·</span>
    <a href={`${base}/#datenschutz`}>Datenschutz</a><span aria-hidden="true">·</span>
    <span>© 2026 mitrilmo</span>
  </footer>
  <script is:inline set:html={gameJs}></script>
</body>
</html>
