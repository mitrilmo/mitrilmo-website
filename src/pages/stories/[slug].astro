---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContentImage from '../../components/ContentImage.astro';
import PageHero from '../../components/PageHero.astro';
import { dateDe } from '../../lib/date.js';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).filter((s) => !s.data.draft);
  return stories.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const weltreise = data.series === 'weltreise';
const back = weltreise ? { href: `${root}/weltreise.html`, text: '← Zur Weltumrundung 2017' } : { href: `${root}/`, text: '← Startseite' };
// Vorschaubild für Link-Vorschauen (JPEG); ohne Titelbild gilt das Kanal-Logo
const og = data.cover ? await getImage({ src: data.cover, width: 1200, format: 'jpeg', quality: 70 }) : null;
---
<Base title={`${data.title}, mitrilmo`} description={data.description} ogImage={og?.src} ogType="article">
  <PageHero width="max-w-2xl" scenery={false}>
    <p class="text-sm"><a href={back.href} class="text-accent hover:underline">{back.text}</a></p>
    <p class="mt-6 flex flex-wrap items-center gap-3 text-xs">
      {weltreise && <span class="bg-slate-900/50 border border-accent/40 text-accent font-semibold px-3 py-1 rounded-full">🌍 Weltumrundung 2017 · Tag {data.day}</span>}
      <time datetime={data.date.toISOString().slice(0, 10)} class="text-stone-300">{dateDe(data.date)}</time>
    </p>
    <h1 class="mt-3 text-3xl font-black text-stone-50 leading-tight">{data.title}</h1>
  </PageHero>

  <article class="max-w-2xl mx-auto px-4 py-10">
    {data.cover && <ContentImage image={data.cover} alt={data.coverAlt} sizes="(min-width: 672px) 640px, 100vw" widths={[480, 800, 1200]} priority class="w-full rounded-xl max-h-[28rem] object-cover" />}
    <div class="mt-6 text-stone-200 leading-relaxed [&_p]:mt-4 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-stone-50 [&_p>img]:block [&_p>img]:w-full [&_p>img]:h-auto [&_p>img]:rounded-xl [&_p>img+em]:block [&_p>img+em]:mt-2 [&_p>img+em]:text-center [&_p>img+em]:text-xs [&_p>img+em]:text-stone-400 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_a]:text-accent [&_a]:underline">
      <Content />
    </div>
    {data.video && (
      <p class="mt-8">
        <a href={`https://www.youtube.com/watch?v=${data.video}`} target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-2 rounded-full border border-accent text-accent hover:bg-slate-700 transition-colors">Kurzvideo auf YouTube ansehen</a>
        <span class="block mt-2 text-xs text-stone-400">Kleiner animierter KI-Clip zu diesem Tag, auf YouTube nicht gelistet.</span>
      </p>
    )}
  </article>
</Base>
