---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContentImage from '../../components/ContentImage.astro';
import PageHero from '../../components/PageHero.astro';
import SelbstBezahlt from '../../components/SelbstBezahlt.astro';
import { withBase } from '../../lib/url.js';
import { teaser, published, isExternal } from '../../lib/news.js';
import { dateDe } from '../../lib/date.js';

export async function getStaticPaths() {
  const posts = published(await getCollection('news'));
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, '');
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const facts = [data.mood && `Stimmung: ${data.mood}`, data.weather, data.rating && `${data.rating} von 5 Sternen`].filter(Boolean);
const og = await getImage({ src: data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 70 });
---
<Base title={`${data.title}, mitrilmo`} description={teaser(entry, 155)} ogImage={og.src} ogType="article">
  <PageHero width="max-w-2xl" scenery={false}>
    <p class="text-sm"><a href={`${root}/neuigkeiten.html`} class="text-accent hover:underline">← Alle Neuigkeiten</a></p>
    <h1 class="mt-4 text-3xl font-black text-stone-50 leading-tight">{data.title}</h1>
    <p class="mt-2 text-sm text-stone-300">
      <time datetime={data.date.toISOString().slice(0, 10)}>{dateDe(data.date)}</time>
      {facts.length > 0 && <span> · {facts.join(' · ')}</span>}
    </p>
  </PageHero>

  <article class="max-w-2xl mx-auto px-4 py-10">
    <ContentImage avifOnly image={data.cover} alt={data.coverAlt} sizes="(min-width: 672px) 640px, 100vw" widths={[480, 800, 1200]} priority class="w-full rounded-xl max-h-[28rem] object-cover" />

    <div class="mt-6 text-stone-200 leading-relaxed [&_p]:mt-4 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-stone-50 [&_a]:text-accent [&_a]:underline">
      <Content />
    </div>

    {data.sections.map((s) => (
      <section class="mt-8">
        <h2 class="text-xl font-bold text-stone-50">{s.heading}</h2>
        {s.text.split(/\n\s*\n/).filter((t) => t.trim()).map((t) => <p class="mt-4 text-stone-200 leading-relaxed">{t.trim()}</p>)}
        {s.photos.length > 0 && (
          <ul class="mt-6 grid grid-cols-2 gap-2">
            {s.photos.map((p) => (
              <li><ContentImage avifOnly image={p.image} alt={p.alt} sizes="(min-width: 672px) 320px, 50vw" widths={[480, 800]} quality={60} class="w-full aspect-[3/4] object-cover rounded-lg" /></li>
            ))}
          </ul>
        )}
      </section>
    ))}

    {data.photos.length > 0 && (
      <ul class="mt-8 grid grid-cols-2 gap-2">
        {data.photos.map((p) => (
          <li><ContentImage image={p.image} alt={p.alt} sizes="(min-width: 672px) 320px, 50vw" widths={[480, 800]} class="w-full aspect-square object-cover rounded-lg" /></li>
        ))}
      </ul>
    )}

    {data.link && (
      <p class="mt-8">
        <a
          href={withBase(base, data.link.href)}
          {...(isExternal(data.link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          class="inline-block px-4 py-2 rounded-full border border-accent text-accent hover:bg-slate-700 transition-colors"
        >{data.link.text}</a>
      </p>
    )}

    {data.tags.length > 0 && <p class="mt-8 text-xs text-stone-400">{data.tags.map((t) => `#${t}`).join(' ')}</p>}

    <SelbstBezahlt class="mt-10" />
  </article>
</Base>
