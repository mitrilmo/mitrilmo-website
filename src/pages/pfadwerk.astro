---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Prose from '../components/Prose.astro';
import { PREMIUM_CODES } from '../data/premium-codes.js';

const entry = await getEntry('pages', 'pfadwerk');
const { Content, headings } = await render(entry);
const { data } = entry;
const toc = headings.filter((h) => h.depth === 2);

// Monatscode nach dem Datum des Besuchers (die App akzeptiert nur den Code des laufenden Monats). Ohne JavaScript bleibt der Hinweistext.
const codeScript = `(function () {
  var CODES = ${JSON.stringify(PREMIUM_CODES)};
  var MONTHS = ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"];
  var box = document.querySelector("[data-premium-code]");
  if (!box) return;
  var now = new Date();
  var key = now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0");
  box.textContent = "";
  var label = document.createElement("p");
  var code = document.createElement("p");
  if (CODES[key]) {
    label.textContent = "Freischalt-Code für " + MONTHS[now.getMonth()] + " " + now.getFullYear();
    code.textContent = CODES[key];
    code.className = "mt-2 font-mono text-2xl md:text-3xl font-black text-white tracking-wider";
  } else {
    label.textContent = "Freischalt-Code";
    code.textContent = "Für diesen Monat ist noch kein Code eingetragen.";
    code.className = "mt-2 text-base font-semibold text-stone-300";
  }
  label.className = "text-xs text-accent font-semibold uppercase tracking-widest";
  box.appendChild(label);
  box.appendChild(code);
})();`;
---
<Base title={`${data.title}: die App zum Wandertagebuch, mitrilmo`} description={data.description}>
  <PageHero width="max-w-3xl">
    {data.badge && <p class="inline-flex items-center gap-2 bg-slate-900/50 border border-accent/40 px-3 py-1 rounded-full text-accent text-xs font-semibold">{data.badge}</p>}
    {data.status && <p class="mt-3 text-xs text-stone-300">{data.status}</p>}
    <h1 class="mt-2 text-4xl font-black text-stone-50">{data.title}</h1>
    {data.subtitle && <p class="mt-2 text-lg text-stone-200">{data.subtitle}</p>}
  </PageHero>

  <article class="max-w-3xl mx-auto px-4 py-10">
    <nav aria-label="Inhalt" class="mb-8 rounded-xl border border-white/5 bg-slate-700 p-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Inhalt</p>
      <ul class="mt-2 grid gap-1 sm:grid-cols-2 text-sm">
        {toc.map((h) => <li><a href={`#${h.slug}`} class="text-stone-300 hover:text-accent transition-colors">{h.text}</a></li>)}
      </ul>
    </nav>

    <Prose><Content /></Prose>
  </article>
  <script is:inline set:html={codeScript}></script>
</Base>
