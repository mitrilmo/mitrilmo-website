---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { dateDe } from '../lib/date.js';

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const days = (await getCollection('stories'))
  .filter((s) => s.data.series === 'weltreise' && !s.data.draft)
  .sort((a, b) => a.data.day - b.data.day);
const first = days[0]?.data.date;
const last = days.at(-1)?.data.date;
const videos = days.filter((d) => d.data.video).length;
---
<Base title="Weltumrundung 2017, mitrilmo" description="Lange bevor es mitrilmo gab: Björn und Ursel umrunden 2017 in 23 Tagen die Welt. Dubai, Kuala Lumpur, Singapur, Sydney, Fidschi und Los Angeles, Tag für Tag.">
  <PageHero>
    <p class="inline-flex items-center gap-2 bg-slate-900/50 border border-accent/40 px-3 py-1 rounded-full text-accent text-xs font-semibold uppercase tracking-widest">
      <span class="w-1.5 h-1.5 bg-accent rounded-full"></span>Weltumrundung 2017
    </p>
    <h1 class="mt-3 text-3xl font-black text-stone-50">23 Tage, einmal um den Globus</h1>
    <p class="mt-2 text-stone-200 max-w-2xl">Lange bevor es mitrilmo gab: Björn und Ursel umrunden 2017 in 23 Tagen die Welt. Dubai, Kuala Lumpur, Singapur, Sydney, Fidschi und Los Angeles. Das Reisetagebuch, Tag für Tag.</p>
    {first && last && <p class="mt-2 text-sm text-stone-300">{days.length} Berichte, {dateDe(first)} bis {dateDe(last)}</p>}
    {videos > 0 && <p class="mt-2 text-sm text-stone-300">Zu einigen Tagen gibt es einen kleinen animierten KI-Clip. Die Clips sind auf YouTube nicht gelistet und nur über die Links hier erreichbar.</p>}
  </PageHero>

  <section class="max-w-4xl mx-auto px-4 py-10">
    <ol class="grid gap-4 sm:grid-cols-2">
      {days.map((d) => (
        <li class="bg-slate-700 rounded-xl border border-white/5 hover:border-accent/50 transition-colors p-4 flex flex-col gap-2">
          <p class="flex items-center justify-between text-xs">
            <span class="bg-slate-900/60 text-accent border border-accent/40 font-semibold px-2.5 py-0.5 rounded-full">Tag {d.data.day}</span>
            <time datetime={d.data.date.toISOString().slice(0, 10)} class="text-stone-400">{dateDe(d.data.date)}</time>
          </p>
          <h2 class="text-sm font-bold text-stone-50 leading-snug"><a href={`${root}/stories/${d.id}.html`} class="hover:text-accent transition-colors">{d.data.title}</a></h2>
          <p class="text-xs text-stone-400 leading-relaxed flex-1">{d.data.description}</p>
          <p class="mt-1 flex items-center justify-between text-xs">
            <a href={`${root}/stories/${d.id}.html`} class="text-accent hover:underline">Weiterlesen →</a>
            {d.data.video && <a href={`https://www.youtube.com/watch?v=${d.data.video}`} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Kurzvideo ansehen</a>}
          </p>
        </li>
      ))}
    </ol>
  </section>
</Base>
