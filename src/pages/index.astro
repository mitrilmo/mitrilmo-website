---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LegalModals from '../components/LegalModals.astro';
import HeroScene from '../components/HeroScene.astro';
import HeroPartikel from '../components/HeroPartikel.astro';
import ContentImage from '../components/ContentImage.astro';
import anchorsFn from '../lib/anchors.js?raw';
import { nav } from '../data/nav.js';
import { published } from '../lib/news.js';
import { upcoming, rangeDe } from '../lib/events.js';
import { dateDe } from '../lib/date.js';
import { difficultyLabel, kmDe } from '../lib/tours.js';
import { kalenderTexte, spruchFuer } from '../lib/sprueche.js';
import spruchSchluesselFn from '../lib/spruch-schluessel.js?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Spruch am Wegesrand: Der Browser nimmt den Spruch des Tages nach dem Datum des Besuchers aus dem festen Kalender.
// Ohne JavaScript bleibt der Spruch vom Tag des Seitenbaus stehen.
const spruchHeute = spruchFuer(new Date());
const spruchScript = `var SPRUECHE_TAG = ${JSON.stringify(kalenderTexte())};
${spruchSchluesselFn}
(function () {
  var el = document.getElementById('spruch');
  var t = SPRUECHE_TAG[spruchSchluessel(new Date())];
  if (el && t) el.textContent = t;
})();`;

// Alte Anker (#touren usw.) leiten im Browser auf die neuen Seiten weiter, sobald es sie gibt.
// #impressum und #datenschutz öffnen die Modals (LegalModals), kein Redirect.
const livePages = nav.filter((n) => n.live).map((n) => n.href);
const anchorScript = `var LIVE_PAGES = ${JSON.stringify(livePages)}; var SITE_BASE = ${JSON.stringify(base)};
${anchorsFn}
(function () {
  var r = resolveHash(location.hash, LIVE_PAGES);
  if (r && r.type === 'redirect') location.replace(SITE_BASE + '/' + r.to);
})();`;

const [tours, videos, stories, news, events] = await Promise.all(
  ['tours', 'videos', 'stories', 'news', 'events'].map((c) => getCollection(c)),
);
const watch = (v) => `https://www.youtube.com/watch?v=${v.data.youtubeId}`;
const longVideos = videos.filter((v) => v.data.format === 'video').sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
const shortCount = videos.filter((v) => v.data.format === 'short').length;

// "Neu bei mitrilmo": das Jüngste aus Touren, Videos, Geschichten und Neuigkeiten, nach Datum. Die Weltreise von 2017 zählt nicht.
const fresh = [
  ...tours.map((t) => ({ kind: t.data.kind === 'ziel' ? 'Ausflugsziel' : 'Tour', title: t.data.title, date: t.data.publishedAt, href: `${base}/touren/${t.id}.html`, image: t.data.image, alt: t.data.imageAlt })),
  ...longVideos.filter((v) => v.data.publishedAt && v.data.thumbnail).map((v) => ({ kind: 'Video', title: v.data.title, date: v.data.publishedAt, href: watch(v), external: true, image: v.data.thumbnail, alt: `Vorschaubild: ${v.data.title}` })),
  ...stories.filter((s) => !s.data.series && !s.data.draft).map((s) => ({ kind: 'Geschichte', title: s.data.title, date: s.data.date, href: `${base}/stories/${s.id}.html`, image: s.data.cover, alt: s.data.coverAlt })),
  ...published(news).map((n) => ({ kind: 'Neuigkeit', title: n.data.title, date: n.data.date, href: `${base}/neuigkeiten/${n.id}.html`, image: n.data.cover, alt: n.data.coverAlt })),
].sort((a, b) => b.date - a.date).slice(0, 4);

const weekend = tours.filter((t) => t.data.kind === 'tour' && t.data.video).sort((a, b) => b.data.publishedAt - a.data.publishedAt).slice(0, 3);
const nextEvent = upcoming(events).find((e) => e.data.scope === 'region');
const standalone = stories.filter((s) => !s.data.series && !s.data.draft).length;

const signs = [
  {
    href: 'touren.html', title: 'Raus ins Grüne', left: false,
    text: 'Touren mit Streckenverlauf, Höhenprofil und GPX-Download.',
    icon: ['M5 19c0-8 5-14 14-14 0 9-6 14-14 14Z', 'M5 19l8-8'],
    small: ['M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Z', 'M12 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z'],
  },
  {
    href: 'videos.html', title: 'Auf der Couch mitkommen', left: true,
    text: `Die Videos vom Kanal: ${longVideos.length} Videos und ${shortCount} Shorts.`,
    icon: ['M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z', 'M10 9.5v5l4.5-2.5z'],
    small: ['M4 6h16v11H4z', 'M9 21h6'],
  },
  {
    href: 'geschichten.html', title: 'Zum Nachlesen', left: false,
    text: `${standalone} Berichte und Randnotizen, dazu das Reisetagebuch von 2017.`,
    icon: ['M3 5h7a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H3V5Z', 'M21 5h-7a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h7V5Z'],
    small: ['M6 3h9l4 4v14H6z', 'M9 12h7M9 16h7'],
  },
];
---
<Base title="mitrilmo: Raus. Entdecken. Teilen." description="Wandern, Radfahren und Neugier im Bergischen Land, in NRW und darüber hinaus: Touren mit GPX-Download, Videos und Geschichten von mitrilmo.">
  <script slot="head" is:inline set:html={anchorScript}></script>

  <section class="sky relative overflow-hidden">
    <HeroScene />
    <HeroPartikel />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-slate-950/30 to-transparent" aria-hidden="true"></div>
    <div class="relative max-w-5xl mx-auto px-4 py-12 md:py-20 grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <h1 class="text-4xl md:text-5xl font-black text-stone-50 leading-tight">Raus.<br /><span class="text-accent">Entdecken.</span><br />Teilen.</h1>
        <span class="mt-5 block h-1 w-28 rounded-full bg-gradient-to-r from-accent to-transparent" aria-hidden="true"></span>
        <p class="mt-4 text-lg text-stone-100">Unterwegs im Bergischen Land, in NRW und darüber hinaus.</p>
        <figure class="mt-7 max-w-md min-h-[7rem] md:min-h-[5.25rem]">
          <figcaption class="text-xs font-semibold uppercase tracking-widest text-accent">Spruch am Wegesrand</figcaption>
          <blockquote id="spruch" class="mt-2 border-l-2 border-accent/60 pl-4 text-lg italic leading-snug text-stone-100">{spruchHeute}</blockquote>
        </figure>
        <script is:inline set:html={spruchScript}></script>
      </div>
      <nav aria-label="Einstieg" class="relative py-4">
        <div class="post absolute left-1/2 top-0 bottom-0 w-12 -translate-x-1/2" aria-hidden="true"></div>
        <ul class="relative flex flex-col gap-5">
          {signs.map((s) => (
            <li class={`sign-item w-[94%] ${s.left ? 'self-start' : 'self-end'}`}>
              <a href={`${base}/${s.href}`} class={`sign ${s.left ? 'sign-left' : ''}`}>
                <svg viewBox="0 0 24 24" class="h-8 w-8 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{s.icon.map((d) => <path d={d} />)}</svg>
                <span class="text-xl font-extrabold leading-tight">{s.title}</span>
              </a>
              <p class="plaque w-[78%] mx-auto text-sm font-semibold leading-snug">
                <svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{s.small.map((d) => <path d={d} />)}</svg>
                <span class="border-l border-[#3a2810]/30 pl-3">{s.text}</span>
              </p>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12" aria-labelledby="neu">
    <h2 id="neu" class="text-2xl font-extrabold text-stone-50">Neu bei mitrilmo</h2>
    <p class="mt-1 text-sm text-stone-400">Alle ein bis drei Wochen kommt etwas Neues dazu.</p>
    <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {fresh.map((f, i) => (
        <li>
          <a href={f.href} {...(f.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="group block h-full bg-slate-700 rounded-2xl overflow-hidden border border-white/5 hover:border-accent/50 transition-colors">
            {f.image && f.alt
              ? <ContentImage image={f.image} alt={f.alt} sizes="(min-width: 1024px) 240px, (min-width: 640px) 45vw, 100vw" widths={[480, 800]} priority={i < 2} class="w-full h-36 object-cover" />
              : <div class="sky h-36 flex items-end p-4" aria-hidden="true"><span class="text-sm font-semibold text-stone-100/90">{f.kind}</span></div>}
            <div class="p-4">
              <p class="text-xs text-stone-400">{f.kind} · <time datetime={f.date.toISOString().slice(0, 10)}>{dateDe(f.date)}</time></p>
              <h3 class="mt-1 font-bold text-stone-50 leading-snug group-hover:text-accent transition-colors">{f.title}{f.external && <span class="sr-only"> (öffnet YouTube in einem neuen Tab)</span>}</h3>
            </div>
          </a>
        </li>
      ))}
    </ul>
    {nextEvent && (
      <p class="mt-6 text-sm text-stone-300">
        Als Nächstes in der Region: <a href={`${base}/termine.html`} class="text-accent hover:underline">{nextEvent.data.title}</a> ({rangeDe(nextEvent.data.startDate, nextEvent.data.endDate)}).
      </p>
    )}
  </section>

  <section class="bg-slate-900/40 border-y border-white/5" aria-labelledby="wochenende">
    <div class="max-w-5xl mx-auto px-4 py-12">
      <h2 id="wochenende" class="text-2xl font-extrabold text-stone-50">Für das Wochenende</h2>
      <p class="mt-1 text-stone-300 max-w-2xl">Wie weit soll es gehen? Gemütlich oder anspruchsvoll? Talsperre, Aussicht oder einfach Natur? Im Tourenfinder filterst du nach Länge und Schwierigkeit. Hier drei Touren zum Einstieg.</p>
      <ul class="mt-5 grid gap-5 md:grid-cols-3">
        {weekend.map((t) => (
          <li>
            <a href={`${base}/touren/${t.id}.html`} class="group block h-full bg-slate-700 rounded-2xl overflow-hidden border border-white/5 hover:border-accent/50 transition-colors">
              <ContentImage image={t.data.image} alt={t.data.imageAlt} sizes="(min-width: 768px) 320px, 100vw" widths={[480, 800]} class="w-full h-40 object-cover" />
              <div class="p-4">
                <p class="text-xs text-stone-400">{t.data.place}</p>
                <h3 class="mt-1 font-bold text-stone-50 leading-snug group-hover:text-accent transition-colors">{t.data.title}</h3>
                <p class="mt-2 text-sm text-stone-300">{[kmDe(t.data.distanceKm), t.data.duration, difficultyLabel[t.data.difficulty]].join(' · ')}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6"><a href={`${base}/touren.html`} class="inline-block rounded-full border border-accent px-5 py-2 text-sm font-semibold text-accent hover:bg-slate-700">Alle Touren und die Karte</a></p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12" aria-labelledby="mo">
    <div class="max-w-2xl">
      <h2 id="mo" class="text-2xl font-extrabold text-stone-50">Wer ist Mo?</h2>
      <p class="mt-3 text-stone-200 leading-relaxed">Ich bin Björn, meistens als Mo unterwegs. mitrilmo ist mein persönlicher YouTube-Kanal für Familienausflüge, Wandertouren und ehrliche Gadget-Tests, mitten im Bergischen Land und darüber hinaus. Was war gut? Was würde ich anders machen? Kann ich das empfehlen?</p>
      <p class="mt-3"><a href={`${base}/ueber-mitrilmo.html`} class="text-accent hover:underline">Mehr über mich und den Kanal →</a></p>
    </div>
  </section>

  <section class="bg-slate-900/40 border-t border-white/5" aria-labelledby="dranbleiben">
    <div class="max-w-5xl mx-auto px-4 py-12">
      <h2 id="dranbleiben" class="text-2xl font-extrabold text-stone-50">Dranbleiben</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        <a href="https://www.youtube.com/@mitrilmo" target="_blank" rel="noopener noreferrer" class="block bg-slate-700 rounded-2xl border border-white/5 hover:border-accent/50 transition-colors p-5">
          <p class="font-bold text-stone-50">Keine neue Runde verpassen</p>
          <p class="mt-1 text-sm text-stone-300">Abonniere den Kanal auf YouTube.</p>
          <p class="mt-2 text-sm text-accent">YouTube @mitrilmo ↗<span class="sr-only"> (öffnet in einem neuen Tab)</span></p>
        </a>
        <a href="https://www.komoot.com/de-de/user/848397235919" target="_blank" rel="noopener noreferrer" class="block bg-slate-700 rounded-2xl border border-white/5 hover:border-accent/50 transition-colors p-5">
          <p class="font-bold text-stone-50">Die Touren nachlaufen</p>
          <p class="mt-1 text-sm text-stone-300">Folge mir auf Komoot, dann hast du die Strecken auf der Uhr oder im Smartphone.</p>
          <p class="mt-2 text-sm text-accent">Komoot ↗<span class="sr-only"> (öffnet in einem neuen Tab)</span></p>
        </a>
      </div>
      <p class="mt-6 text-sm text-stone-400">
        Außerdem von mir: Einfach mal KI, mein zweiter Kanal, auf{' '}
        <a href="https://www.youtube.com/@EinfachMalKI" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">YouTube<span class="sr-only"> (öffnet in einem neuen Tab)</span></a>{' '}und{' '}
        <a href="https://www.instagram.com/Einfach_mal_KI" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Instagram<span class="sr-only"> (öffnet in einem neuen Tab)</span></a>.
      </p>
    </div>
  </section>
  <LegalModals />
</Base>
