{
  "name": "mitrilmo-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:live": "node scripts/build.mjs live",
    "blog-import": "node scripts/blog-import.mjs",
    "check:content":"node scripts/check-content.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run check:content && npm run build && npm run check:dist",
    "check:live": "npm run check:content && npm run build:live && node scripts/check-dist.mjs --live"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "yaml": "^2.9.1"
  }
}
